# ──────────────────────────────────────────────────────────────────────────────
# SROP — Stateful RAG Orchestration Pipeline
# .env.example
#
# Copy this file to `.env` and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────────────────
# Obtain your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="Paste the Key"

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (relative path — file created in project root)
DATABASE_URL=sqlite+aiosqlite:///./srop.db

# Docker (absolute path inside the /data volume — used by docker-compose.yml)
# DATABASE_URL=sqlite+aiosqlite:////data/srop.db

# PostgreSQL (for multi-replica production deploys)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/srop

# ── Vector store ──────────────────────────────────────────────────────────────
# Local dev
VECTOR_STORE_PATH=./vector_store

# Docker (inside /data volume)
# VECTOR_STORE_PATH=/data/vector_store

# ── App settings ──────────────────────────────────────────────────────────────
APP_NAME=SROP
DEBUG=false
